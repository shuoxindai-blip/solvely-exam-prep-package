{
  "name": "solvely-exam-prep-package",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:data": "node scripts/build-sat-data.mjs && node scripts/build-act-data.mjs",
    "build:act-data": "node scripts/build-act-data.mjs",
    "verify:data": "node scripts/verify-sat-importance.mjs && node scripts/verify-sat-content-separation.mjs",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --pretty false",
    "verify": "npm run verify:data && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.0.6"
  },
  "devDependencies": {}
}
